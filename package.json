{
  "name": "dsh-plugin-updater",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: an Update button on third-party plugin pages that reinstalls the plugin from its original source (GitHub, git, local path or tarball), keeping it enabled.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luyang950/dsh-plugin-updater.git"
  },
  "homepage": "https://github.com/luyang950/dsh-plugin-updater#readme",
  "bugs": {
    "url": "https://github.com/luyang950/dsh-plugin-updater/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.3.0-0"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-0 <0.3.0-0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "plugin-manager",
    "update"
  ]
}
